<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- noupdate="1": seeded once, then owned by the client — an upgrade must never
         silently reset number_next back to this file's value and erase a manual
         recalibration (e.g. to continue the pre-existing catalog numbering). -->
    <!-- One global counter, never reset per category — matches the original app's
         "Product Sequence" (ir.sequence, 8-digit padding). Initial seed value only;
         see the note above for why it must not be re-applied after install. -->
    <record id="seq_product_sku" model="ir.sequence">
        <field name="name">Darakjian — Auto SKU</field>
        <field name="code">yaguven.product.sku</field>
        <field name="padding">8</field>
        <field name="number_next">11000000</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
